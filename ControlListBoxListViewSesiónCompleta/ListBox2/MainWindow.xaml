<Window x:Class="ListBox2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ListBox2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <Label Content="Nombre" Margin="13,5"/>
            <TextBox Name="Entrada" Margin="0,5" Width="200"
                     VerticalContentAlignment="Center"
                     IsEnabled="True" TextChanged="Entrada_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0">
            <Label Content="Apellidos" Margin="10,5" />
            <TextBox Name="Entrada2" Margin="0,5" Width="200" 
                     VerticalContentAlignment="Center" 
                     IsEnabled="False"/>
        </StackPanel>
        <Button Grid.Row="0" Grid.Column="1" Content="Añadir"
                Margin="10,5" Padding="5" Name="BotonAniadir" 
                Click="BotonAniadir_Click" IsEnabled="False"
                IsDefault="True"/>
        <ListBox Name="TablaListBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 SelectionChanged="TablaListBox_SelectionChanged"/>
        <TextBlock Name="Salida" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="10" FontSize="12"/>
    </Grid>
</Window>
