<Window x:Class="AnimacionesListView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnimacionesListView"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Name="GridBotones" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Crear figura" Name="BotonCrear" Margin="10,5" Click="BotonCrear_Click"/>
            <Button Grid.Column="1" Content="Animar" Name="BotonAnimar" Margin="10,5" Click="BotonAnimar_Click"/>
        </Grid>
        <Canvas Name="miCanvas" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <ListView Name="TablaListView" Grid.Row="2" SelectionMode="Single"
                  SelectionChanged="TablaListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="La figura" 
                                        DisplayMemberBinding="{Binding strLaFig}"/>
                        <GridViewColumn Header="Coordenada X" 
                                        DisplayMemberBinding="{Binding posX}"/>
                        <GridViewColumn Header="Coordenada Y" 
                                        DisplayMemberBinding="{Binding posY}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
