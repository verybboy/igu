<Window x:Class="lista_amigos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lista_amigos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Label Width="70">Nombre: </Label>
            <TextBox Name="txtNombre" Margin="10" Padding="5" HorizontalAlignment="Left" Width="400"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Label Width="70">Apellidos: </Label>
            <TextBox Name="txtApellidos" Margin="10" Padding="5" HorizontalAlignment="Left" Width="400"/>
        </StackPanel>
        
        <Button Name="btnAnyadir" Grid.Column="1" Margin="10" Padding="5">Añadir</Button>

        <ListBox Name="lstAmigos" Grid.Row="2" Grid.ColumnSpan="2" Margin="10"></ListBox>

        <TextBlock Name="txtAmigo" Grid.Row="3" Grid.ColumnSpan="2" Height="20" Background="Aquamarine" Margin="10" Padding="5"></TextBlock>
    </Grid>
</Window>
