<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="SegundaSesion" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="C:\Users\i0910938\Desktop\arte.jpg"/>
    </Window.Background>
    <StackPanel Orientation="Horizontal">
        <StackPanel>
            <Button Margin="10 10 10 5" Name="btnInvertir" Click="btnInvertir_Click">Invierte</Button>
            <Button Margin="10 5 10 5" Name="btnMayusculas" Click="btnMayusculas_Click">Mayúsculas</Button>
            <Button Margin="10 5 10 5" Padding="3" Name="btnRojo" Click="btnRojo_Click">
                <Rectangle Fill="Red" Width="20" Height="20"></Rectangle>
            </Button>
            <Button Margin="10 5 10 10" Padding="3" Name="btnVerde" Click="btnVerde_Click">
                <Rectangle Fill="Green" Width="20" Height="20"></Rectangle>
            </Button>
        </StackPanel>
        <StackPanel>
            <TextBox Name="txtEntrada" Width="180" Margin="10 10 10 5"></TextBox>
            <Label Name="lblSalida" Background="Aqua" Foreground="Red" Margin="10 5 10 10"></Label>
        </StackPanel>
    </StackPanel>
</Window>
